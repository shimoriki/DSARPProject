# Large tool binaries/archives
tools/**/*.zip
tools/**/*.jar

# Large data formats Claude should not ingest directly
*.jsonl
*.log
*.graphml
*.dot

# Third-party tool binaries — NOT redistributable / far too large for git.
# DesigniteJava Professional in particular is licensed commercial software.
# Install these locally; see docs/SETUP_TOOLS.md.
tools/*
!tools/dsarp-recipes/
tools/dsarp-recipes/target/

# Raw tool-output dataset supplied by the user (817MB of Arcan/Designite CSVs + PDFs)
# and generated source indexes. Regenerated by the pipeline; far too large for git.
DSARP dataset/
data/source_index/
