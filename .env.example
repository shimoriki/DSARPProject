# DSARP Refactoring Suggestion Studio - environment overrides.
# Every value is optional; config/config.yaml holds the same settings.
# Environment variables win over the YAML file.

# Path to the YAML config file
DSARP_CONFIG=./config/config.yaml

# SQLite database location
DSARP_DB_PATH=./data/dsarp.db

# Local model endpoint (no cloud APIs required)
# provider: ollama | openai_compat | llamacpp | hf_endpoint | mock
DSARP_MODEL_PROVIDER=ollama
DSARP_MODEL_BASE_URL=http://localhost:11434
DSARP_MODEL_ID=qwen2.5-coder:7b
DSARP_MODEL_TEMPERATURE=0.2
DSARP_MODEL_MAX_TOKENS=1400

# Only needed for endpoints that require a key (never required for ollama/llama.cpp)
DSARP_API_KEY=

# Reviewer identity recorded on human reviews and audit entries
DSARP_REVIEWER_ID=local_user
